from random import randint
from statistics import mean


def avg_num(numbers):
  result = sum(numbers)/len(numbers)
  return result

rand_numbers = []

for i in range (10):
  num = randint(1,100)
  rand_numbers.append(num)

print("Random Numbers:",rand_numbers)

average = avg_num(rand_numbers)

print("Average of Numbers:", average)

average_builtin = mean(rand_numbers)

print("Average of Numbers in (Built_in _func):",average_builtin)

if(average == average_builtin):
  print("Yes,both averages are the same.")
else:
  print("No,they are different.")

